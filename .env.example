# TezDukan environment variables.
# Copy to .env.local for local development. Never commit real secrets.
# Every integration runs in a clearly labelled Sandbox mode until its keys are set.

# ─── App ──────────────────────────────────────────────────────────────────────────────────
# Public base URL. Used in SMS/WhatsApp links, QR posters, Open Graph tags and webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | staging | production. Non-production shows an environment badge in the UI.
NEXT_PUBLIC_APP_ENV=development
# TezDukan support WhatsApp number (E.164, +92…). Shown where people need human help,
# e.g. password reset while SMS is still in Sandbox.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ─── Supabase ─────────────────────────────────────────────────────────────────────────────
# Project API URL. Local: `pnpm db:status` → API_URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). SERVER ONLY: admin actions, seeding, webhooks. Never expose.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string, used by seed scripts. Local default shown.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── SMS (OTP, password reset, reminders) ────────────────────────────────────────────────
# Adapter: sandbox | twilio | veevotech | eocean. Sandbox stores messages in message_outbox
# and shows them in Admin → Outbox instead of sending.
SMS_PROVIDER=sandbox
# Provider credentials (meaning depends on the adapter).
SMS_API_KEY=
SMS_API_SECRET=
# Sender ID / masking registered with the provider.
SMS_SENDER_ID=TezDukan
# Sandbox only: show sign-up OTP codes on screen so the flow can be completed without SMS.
# Turn OFF before inviting real users if SMS is still in sandbox.
SMS_SANDBOX_REVEAL_OTP=true

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent system-user access token.
WHATSAPP_ACCESS_TOKEN=
# App secret, used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; must match the verify token configured in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=

# ─── Payments ─────────────────────────────────────────────────────────────────────────────
# JazzCash merchant credentials. JAZZCASH_ENV: sandbox | production.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox
# Easypaisa merchant credentials. EASYPAISA_ENV: sandbox | production.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox
# Account shown for Raast / bank transfer payments (customer uploads the receipt).
BANK_TRANSFER_ACCOUNT_TITLE=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_RAAST_ID=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────────────────
# Generate with `pnpm dlx web-push generate-vapid-keys`. Sending happens in a Supabase Edge
# Function, so VAPID_PRIVATE_KEY is also set as an Edge Function secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tezdukan.pk

# ─── Maps ─────────────────────────────────────────────────────────────────────────────────
# osm (Leaflet + OpenStreetMap, default) | google
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Munshi AI ────────────────────────────────────────────────────────────────────────────
# anthropic (default) | gemini. Without keys Munshi shows a clear "AI unavailable" message;
# every manual screen keeps working.
AI_PROVIDER=anthropic
# Agent (tool-calling) model and fast intent/routing model.
AI_MODEL_AGENT=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Models used when AI_PROVIDER=gemini.
GEMINI_MODEL_AGENT=
GEMINI_MODEL_FAST=
# Speech-to-text: browser (Web Speech API) | gemini | whisper
AI_STT_PROVIDER=browser
# OpenAI-compatible Whisper endpoint (used when AI_STT_PROVIDER=whisper).
STT_API_BASE_URL=
STT_API_KEY=
# Text-to-speech for spoken Urdu replies: browser | gemini
AI_TTS_PROVIDER=browser
# Embeddings for hybrid product search: gemini | voyage | none
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
# Guard rails: requests per user per minute, and monthly spend cap per account (in PKR).
AI_RATE_LIMIT_PER_MINUTE=20
AI_MONTHLY_COST_CAP_PKR=3000

# ─── FBR POS (optional, behind the fbr_pos feature flag) ──────────────────────────────────
FBR_POS_ENV=sandbox
FBR_POS_ID=
FBR_POS_ACCESS_TOKEN=

# ─── Product analytics ────────────────────────────────────────────────────────────────────
# Events are always written to the `events` table. PostHog is optional.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Security ─────────────────────────────────────────────────────────────────────────────
# Random 32+ byte strings. API_KEY_PEPPER hashes public API keys; CRON_SECRET guards any
# HTTP cron endpoint; WEBHOOK_SIGNING_SECRET signs outbound webhooks by default.
API_KEY_PEPPER=
CRON_SECRET=
WEBHOOK_SIGNING_SECRET=

# ─── Testing ──────────────────────────────────────────────────────────────────────────────
# Point Playwright at an already running server instead of starting one.
E2E_BASE_URL=
# 1 = run e2e against `next dev` instead of a production build.
E2E_DEV=
