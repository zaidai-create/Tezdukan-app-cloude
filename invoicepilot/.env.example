# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for admin operations in audited code paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Model to use for both chat and vision. Any model that supports JSON mode
# and image input (e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini) works here.
OPENAI_MODEL=gpt-4o-mini
