# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for admin operations in audited code paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider ------------------------------------------------------------
# Which provider powers document understanding: "gemini" (default) or "openai".
AI_PROVIDER=gemini

# Google Gemini (default). Any multimodal model that supports JSON output works.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (only needed when AI_PROVIDER=openai).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
